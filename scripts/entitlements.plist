<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        RemoteDiff is intentionally NOT sandboxed because it spawns /usr/bin/ssh
        and reads from the user's ~/.ssh config to talk to remote git repositories.
        App Sandbox would block both. The app is still notarised by Apple and runs
        with the Hardened Runtime enabled.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!--
        disable-library-validation is deliberately NOT set. ssh and the askpass helper
        run as separate child processes, and library validation only governs code loaded
        into RemoteDiff's own process (which links only system frameworks).
    -->
</dict>
</plist>
